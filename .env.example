# ---------------------------------------------------------------------------
# UniMap environment. Copy to `.env` and fill in. NONE of these are required
# to run the test suite (it defaults to the in-process mock server).
# ---------------------------------------------------------------------------

# Proxy / mock server ports
PROXY_PORT=8787
MOCK_PORT=8788

# Turn on live integration tests (otherwise they are skipped). Requires the
# relevant provider credentials below to be present.
UNIMAP_LIVE=0

# Enable the reverse-engineered / unofficial provider tier. OFF by default.
# These endpoints are undocumented and may violate provider Terms of Service.
UNIMAP_ENABLE_UNOFFICIAL=0

# --- Google Maps Platform -------------------------------------------------
GOOGLE_MAPS_API_KEY=
# Optional OAuth2 access token (or wire a service account) for Geocoding v4 / Places OAuth.
GOOGLE_MAPS_OAUTH_TOKEN=
# Referrer-restricted key handed to the browser Maps JS bootstrap (render façade).
GOOGLE_MAPS_BROWSER_KEY=

# --- Apple Maps (MapKit JS / Maps Server API) -----------------------------
# Either provide the .p8 contents inline or a path to the file.
APPLE_MAPS_PRIVATE_KEY=
APPLE_MAPS_PRIVATE_KEY_PATH=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_TEAM_ID=
# Optional origin restriction baked into the signed MapKit token.
APPLE_MAPS_ORIGIN=

# --- OpenStreetMap stack (override to self-hosted instances for volume) ----
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OSRM_URL=https://router.project-osrm.org
OSM_PHOTON_URL=https://photon.komoot.io
OSM_OVERPASS_URL=https://overpass-api.de/api
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Keyless public-transit routing (MOTIS). Blank ⇒ public Transitous
# (https://api.transitous.org). Point at a self-hosted MOTIS/OTP for volume.
TRANSIT_URL=
# Geofence for transit: reject trips whose endpoints are more than this many km
# apart (catches misgeocodes / cross-country requests). Default 100; 0 disables.
TRANSIT_MAX_KM=100
# Required by the OSM usage policies — identify your app.
OSM_USER_AGENT=unimap-demo/0.1 (set-a-real-contact@example.com)
# Optional hosted vector-tile / basemap keys used by the render façade.
MAPTILER_KEY=
STADIA_MAPS_KEY=
