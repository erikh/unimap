{
  "name": "unimap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified JavaScript/TypeScript SDK over Google Maps, Apple Maps, and OpenStreetMap.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "UNIMAP_LIVE=1 vitest run",
    "dev:mock": "tsx packages/mock-server/src/server.ts",
    "dev:proxy": "tsx packages/proxy/src/server.ts",
    "dev:ui": "node scripts/dev-ui.mjs",
    "example": "tsx examples/try.ts",
    "example:offline": "tsx examples/offline.ts",
    "clean": "rm -rf packages/*/dist apps/*/dist **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
