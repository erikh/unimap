# UniMap mock server — implements the Google/Apple/OSM wire protocols for
# local development and integration tests (no credentials required).
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json* tsconfig.base.json tsconfig.json ./
COPY packages ./packages

RUN npm install --no-audit --no-fund

ENV MOCK_PORT=8788
EXPOSE 8788

CMD ["npx", "tsx", "packages/mock-server/src/server.ts"]
